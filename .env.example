# fable-zh 配置示例
# 复制到 ~/.config/fable-zh/.env 后按需修改；真实环境变量优先于本文件中的同名项。

# LLM 接口（OpenAI 兼容 /chat/completions）
FABLE_ZH_MODEL=deepseek/deepseek-v4-flash
FABLE_ZH_BASE_URL=https://api.deepseek.com/v1
FABLE_ZH_API_KEY=

# 开关
FABLE_ZH_ENABLED=true
FABLE_ZH_INPUT_ENABLED=true
FABLE_ZH_OUTPUT_ENABLED=true

# 行为参数
FABLE_ZH_MAX_INPUT_CHARS=3000
FABLE_ZH_INPUT_TIMEOUT_MS=15000
FABLE_ZH_OUTPUT_TIMEOUT_MS=12000
FABLE_ZH_DISABLE_REASONING=true