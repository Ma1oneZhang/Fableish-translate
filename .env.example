# fableish-translate 配置示例
# 复制到 ~/.config/fableish-translate/.env 后按需修改；真实环境变量优先于本文件中的同名项。

# LLM 接口（OpenAI 兼容 /chat/completions）
FABLEISH_TRANSLATE_MODEL=deepseek/deepseek-v4-flash
FABLEISH_TRANSLATE_BASE_URL=https://api.deepseek.com/v1
FABLEISH_TRANSLATE_API_KEY=

# 开关
FABLEISH_TRANSLATE_ENABLED=true
FABLEISH_TRANSLATE_INPUT_ENABLED=true
FABLEISH_TRANSLATE_OUTPUT_ENABLED=true

# 行为参数
FABLEISH_TRANSLATE_MAX_INPUT_CHARS=3000
FABLEISH_TRANSLATE_INPUT_TIMEOUT_MS=15000
FABLEISH_TRANSLATE_OUTPUT_TIMEOUT_MS=12000
FABLEISH_TRANSLATE_DISABLE_REASONING=true